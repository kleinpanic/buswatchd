[Unit]
Description=buswatchd - USB/HDMI hotplug notifier
# Needs a session bus and a running notification daemon, both of which belong to
# the graphical session rather than to login.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/buswatchd --config %h/.config/buswatchd/config.json
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
