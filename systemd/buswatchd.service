[Unit]
Description=buswatchd - USB/HDMI hotplug notifier
# Ordered after the graphical session because notify-send needs a session bus
# and a running notification daemon. Ordering only, plus lifecycle: the unit is
# WantedBy=default.target so it still autostarts on setups that never activate
# graphical-session.target at all -- bare WMs, and anything without a session
# manager that pulls the target in. Both directives are inert there.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/buswatchd --config %h/.config/buswatchd/config.json
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
